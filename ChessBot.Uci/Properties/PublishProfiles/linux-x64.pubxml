<?xml version="1.0" encoding="utf-8"?>
<!--
  The Linux counterpart of win-x64.pubxml, for testers and lichess-bot hosts on Linux:

    dotnet publish ChessBot.Uci -p:PublishProfile=linux-x64

  Cross-published from Windows; the SDK carries the Linux runtime pack, so no Linux machine is
  needed to build it. See win-x64.pubxml for why each property is set.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\linux-x64\</PublishDir>
    <DebugType>none</DebugType>
    <!-- The one file is the release: no symbols or XML docs from the engine project beside it. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>
</Project>
