<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for testers: one self-contained executable, no .NET runtime required.

    dotnet publish ChessBot.Uci -p:PublishProfile=win-x64

  which is the same as spelling it out:

    dotnet publish ChessBot.Uci -c Release -r win-x64 -self-contained true
      -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true
      -p:InvariantGlobalization=true

  Self-contained because a rating list's tester will not install a runtime to try an engine.
  Single-file because a GUI is pointed at one executable, and a folder of 200 DLLs next to it
  is 200 ways to copy the engine incompletely. Native libraries are folded into the file for
  the same reason; they are extracted to a per-user cache on first start and reused after.
  InvariantGlobalization is already set in the project (see ChessBot.Uci.csproj); it is
  repeated here so the profile states everything the release depends on.

  scripts/publish.ps1 runs this, names the output after the version, and checks what the
  binary reports.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\win-x64\</PublishDir>
    <DebugType>none</DebugType>
    <!-- The one file is the release: no symbols or XML docs from the engine project beside it. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>
</Project>
