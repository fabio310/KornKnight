<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>ChessBot.Engine</AssemblyName>
	<RootNamespace>ChessBot.Engine</RootNamespace>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>

	<!--
	  For the transposition-table prefetch (Sse.Prefetch0 takes a pointer, so the one method that
	  issues it is unsafe). Nothing else in the engine uses it; this is the item P4.2 deferred it to.
	-->
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="ChessBot.Tests" />
  </ItemGroup>

  <ItemGroup>
	<!-- No external dependencies for the engine core -->
  </ItemGroup>

</Project>
